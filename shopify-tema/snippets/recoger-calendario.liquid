{% comment %}
  Calendario del carrito que reacciona al inventario en vivo del sistema de sucursales.
  Configuración: API del sistema, sucursales (nombre = punto de recolección en Shopify) y entrega a domicilio.
  Los horarios de recoger, la preparación y el corte vienen del sistema (RECOGER_* en 01_config_roles.js).
{% endcomment %}
{%- liquid
  assign config = '{
    "api": "https://script.google.com/macros/s/AKfycbxJfDX3lwu5AE9GDA1WGZ3_MP3AAGPsCz54CdzS_cnE9zxQArN1zLmjnZixwc2A13eF/exec",
    "margenMismoDiaMin": 60,
    "sucursales": [
      { "clave": "Cuajimalpa", "nombre": "La Tarta Vasca", "direccion": "Av. Noche de Paz 14, local 16B, Cuajimalpa" },
      { "clave": "Polanco", "nombre": "La Tarta Vasca Polanco", "direccion": "Calle Arquímedes 69, Polanco" }
    ],
    "domicilio": {
      "sucursal": "Cuajimalpa",
      "mismoDia": false,
      "horaCorte": "18:00",
      "horarios": [null, {"abre":"09:00","cierra":"15:00"}, {"abre":"09:00","cierra":"15:00"}, {"abre":"09:00","cierra":"15:00"}, {"abre":"09:00","cierra":"15:00"}, {"abre":"09:00","cierra":"15:00"}, {"abre":"09:00","cierra":"15:00"}]
    },
    "atributos": {
      "canal": ATR_CANAL,
      "sucursal": ATR_SUCURSAL,
      "fecha": "",
      "hora": ""
    }
  }'
  assign atr_sucursal = 'Cuajimalpa'
  if cart.attributes.Location == 'La Tarta Vasca Polanco'
    assign atr_sucursal = 'Polanco'
  endif
  assign atr_canal = 'PICKUP'
  if cart.attributes['Checkout channel'] == 'DELIVERY'
    assign atr_canal = 'DELIVERY'
  endif
  assign atr_canal_json = atr_canal | json
  assign atr_sucursal_json = atr_sucursal | json
  assign config = config | replace: 'ATR_CANAL', atr_canal_json | replace: 'ATR_SUCURSAL', atr_sucursal_json
-%}
{{ 'recoger-calendario.css' | asset_url | stylesheet_tag }}
<div id="recoger-calendario" class="recoger-calendario" data-config="{{ config | escape }}">
  <p class="rc-encabezado">Elige cómo y cuándo quieres tu pedido</p>
  <p class="rc-error" hidden>No pudimos revisar la disponibilidad. Recarga la página o escríbenos por WhatsApp.</p>
  <div class="rc-cuerpo"></div>
</div>
<script src="{{ 'recoger-calendario.js' | asset_url }}" defer="defer"></script>
